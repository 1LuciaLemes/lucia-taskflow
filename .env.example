# Variables para Docker Compose
POSTGRES_USER=task
POSTGRES_PASSWORD=task
POSTGRES_DB=tasks

# Puerto del backend
PORT=3000

# Opcional: para ejecutar el backend de forma local contra Postgres
# (sin Docker), descomentá y ajustá según tu entorno:
# DATABASE_URL=postgres://task:task@localhost:5432/tasks
# PGSSL=false

# Orígenes permitidos por CORS (lista separada por comas) para el deploy.
# Usá * solo para pruebas; en producción poné la URL del frontend.
# CORS_ORIGIN=https://lucia-taskflow.vercel.app

# Clave opcional para la demo: si está definida, las operaciones de
# escritura (POST/PATCH/DELETE) requieren el header x-api-key.
# Si no se define, las escrituras quedan abiertas.
# DEMO_API_KEY=cambia-esta-clave

# URL del backend que consume el frontend (build de Vite).
# Sin definir, usa rutas relativas (proxy de desarrollo).
# VITE_API_URL=https://lucia-taskflow-api.onrender.com

# Modo demo: tablero aislado por navegador + cartel que avisa que los
# datos no se guardan. Activá el modo demo omitiendo DATABASE_URL en el
# backend (persistencia en memoria por sesión) y definiendo esta variable
# en el frontend.
# VITE_DEMO_MODE=true